# These two non-secret values are public and fixed when Next.js builds.
DEVFIX_ANALYSIS_MODE=mock
# In API mode, use the full POST endpoint URL, including /api/analyze.
DEVFIX_API_URL=

# Backend only. Never add AWS credentials to this file.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=
# Leave disabled until inference has been explicitly approved.
DEVFIX_BEDROCK_ENABLED=false
